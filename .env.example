# ==============================================================================
# InterviewIQ Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-use-strong-random-key-32-chars-min
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API Service Config
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_USER=interviewiq
POSTGRES_PASSWORD=interviewiq_dev_pass
POSTGRES_DB=interviewiq_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://interviewiq:interviewiq_dev_pass@localhost:5432/interviewiq_db

# Caching & Background Processing (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# AI Provider Configuration (Google Gemini)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Model-Aware Embedding Layer Configuration (Initial Production Default: gemini-embedding-2)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768
EMBEDDING_VERSION=v1

# Storage Provider Configuration
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./data/uploads
GCS_BUCKET_NAME=interviewiq-resumes-dev

# Authentication & Session Security Policies
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Explicit Interview Lifecycle Timeout Policies
INTERVIEW_INACTIVITY_TIMEOUT_MINUTES=30
INTERVIEW_MAX_DURATION_MINUTES=90

# RAG Retrieval Settings
DEFAULT_TOP_K_RETRIEVAL=5
MIN_RELEVANCE_SCORE=0.70
